# User data (must never be committed)
config.json
history.json
queue.json
cookies.txt
snatch.log
snatch.log.*

# Python bytecode
__pycache__/
*.py[cod]
*.so

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local Claude Code config -- session state, hooks and per-machine settings.
# Written as .claude/* rather than .claude/ because git cannot re-include a
# file whose PARENT DIRECTORY is excluded, and the next line needs to.
.claude/*
# ...except the release recipe, which is project configuration rather than
# local state: releases.md section 1 wants the version-bearing files
# enumerated once and RECORDED, and a recipe only one machine can see records
# nothing. cut-release reads it from the repo.
!.claude/bump.json

# Session working files kept for reference, not shipped: one-off probes
# and stub tests. Each folder carries a README saying what it holds.
archive/

# Virtual environments
.venv/
venv/
env/

# Build outputs and local build cache
bin/
dist/
build/
AppDir/
.cache/
appimagetool
*.AppImage
